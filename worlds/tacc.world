<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="tacc_world">

    <!--
      Geodetic reference: Trondheimsfjorden, Trondheim. The previous
      coordinate (63.446827, 10.421906) is a real street in the Lademoen
      neighborhood (confirmed via reverse geocoding - it resolves to a
      bench on a residential road), not water. QGC overlays the vehicle's
      simulated GPS fix on real-world satellite/map tiles using this
      lat/lon, independent of the Gazebo terrain mesh, so the vehicle
      always appeared to be sitting on land in QGC even though it's
      correctly floating in water in the 3D sim. This coordinate is out
      in the fjord (no land features found via reverse geocoding even at
      max zoom) so QGC's map background now shows water. Must match
      --custom-location in docker-compose.yml's ardupilot-sitl command.
    -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>63.520000</latitude_deg>
      <longitude_deg>10.350000</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Saltwater buoyancy: density=1031 kg/m3 (Jerlov type 0.20), air above z=0 -->
    <plugin filename="gz-sim-buoyancy-system" name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1031.0</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1.0</density>
        </density_change>
      </graded_buoyancy>
      <enable>bluerov2_heavy</enable>
    </plugin>

    <!-- Ocean current: NED (0.1, 0.1, 0.0) m/s -> ENU (0.1, 0.1, 0.0) m/s;
         not natively supported in Gz Harmonic — apply via ArduPilot SITL or custom plugin -->

    <!-- Waves: height=10.0 m; requires gz-waves external plugin if needed -->

    <gravity>0 0 -9.81</gravity>
    <magnetic_field>6e-6 2e-5 -4e-5</magnetic_field>

    <scene>
      <ambient>0.1 0.15 0.2 1</ambient>
      <background>0.05 0.1 0.2 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Sun: azimuth=-88 deg, elevation=20 deg (NED) -> ENU direction (0.9391, -0.0328, -0.3420) -->
    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 100 0 0 0</pose>
      <diffuse>0.9 0.9 0.8 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>0.9391 -0.0328 -0.3420</direction>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- Uniform wind: NED (1.0, 0.0, 0.0) m/s -> ENU (0.0, 1.0, 0.0) m/s -->
    <wind>
      <linear_velocity>0.0 1.0 0.0</linear_velocity>
    </wind>

    <!-- Jet wind: center NED (0,0,3) -> ENU (0,0,-3), velocity NED (0,2,0) -> ENU (2,0,0);
         not a standard SDF wind type — apply via custom plugin if needed -->

    <!-- Water surface: visual only (no collision) so it doesn't obstruct the AUV. -->
    <model name="water_surface">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="surface">
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.05 0.2 0.3 0.6</ambient>
            <diffuse>0.05 0.25 0.4 0.6</diffuse>
            <specular>0.8 0.9 1 0.6</specular>
            <emissive>0 0 0 1</emissive>
          </material>
          <transparency>0.4</transparency>
        </visual>
      </link>
    </model>

    <!-- BlueROV2 Heavy: NED (0.0, 0.0, 0.5) -> ENU (0.0, 0.0, -0.5) -->
    <include>
      <uri>model://bluerov2_heavy</uri>
      <pose>0 0 -0.5 0 0 0</pose>
    </include>

    <include>
      <uri>model://tacc_seafloor</uri>
    </include>

    <include>
      <uri>model://pipe</uri>
    </include>

    <include>
      <uri>model://structure</uri>
    </include>

  </world>
</sdf>
