<?xml version='1.0'?>
<sdf version='1.7'>
  <model name='pipe'>
    <static>true</static>

    <link name='pipe_base'>
      <pose>0 0 0 1.5708 0 0</pose>
      <visual name='visual'>
        <geometry>
          <mesh>
            <uri>model://pipe/pipe1.obj</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <specular>1 1 1 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://pipe/pipe2.png</albedo_map>
              <metalness>0.5</metalness>
              <roughness>0.4</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
      <collision name='collision'>
        <geometry>
          <mesh>
            <uri>model://pipe/pipe1.obj</uri>
          </mesh>
        </geometry>
      </collision>
    </link>

    <!-- Aruco markers — positions converted from NED (N,E,D) -> ENU (E,N,-D), yaw negated -->
    <link name='aruco_01'>
      <pose>-1 0 0.11 0 0 0</pose>
      <visual name='visual'>
        <geometry><box><size>0.15 0.15 0.002</size></box></geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <pbr><metal><albedo_map>model://pipe/aruco-19.png</albedo_map></metal></pbr>
        </material>
      </visual>
    </link>
    <joint name='aruco_01_joint' type='fixed'>
      <parent>pipe_base</parent>
      <child>aruco_01</child>
    </joint>

    <link name='aruco_02'>
